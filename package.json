{
  "name": "@headz/toastboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_TOASTBOARD_EMULATORS=1 next dev",
    "build": "next build",
    "lint": "oxlint src",
    "preview": "pnpm dlx serve out -l 3456",
