{
  "name": "@headz/toastboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ],
    "overrides": {
      "jwks-rsa>jose": "5.10.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_TOASTBOARD_EMULATORS=1 next dev",
    "build": "next build",
    "lint": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "preview": "pnpm build && next start -p 3456",
    "seed": "node scripts/seed.mjs",
    "deploy": "firebase deploy --only firestore,storage,functions --project toastboard",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions,ui"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  }
}
