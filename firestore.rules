rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidSlug(slug) {
      return slug.matches('^[a-z0-9-]{10,80}$');
    }

    function isHexSha256(value) {
      return value is string && value.size() == 64 && value.matches('^[a-f0-9]{64}$');
    }

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() > 12
        && url.size() < 900000
        && (url.matches('^https://.+')
          || url.matches('^http://127\\.0\\.0\\.1:.+')
          || url.matches('^data:image/(jpeg|png|webp);base64,.+'));
    }

    function isValidPhotoUrls(urls) {
      return urls is list
        && urls.size() > 0
        && urls.size() <= 10
        && isValidPhotoUrl(urls[0])
        && (urls.size() < 2 || isValidPhotoUrl(urls[1]))
        && (urls.size() < 3 || isValidPhotoUrl(urls[2]))
        && (urls.size() < 4 || isValidPhotoUrl(urls[3]))
        && (urls.size() < 5 || isValidPhotoUrl(urls[4]))
        && (urls.size() < 6 || isValidPhotoUrl(urls[5]))
        && (urls.size() < 7 || isValidPhotoUrl(urls[6]))
        && (urls.size() < 8 || isValidPhotoUrl(urls[7]))
        && (urls.size() < 9 || isValidPhotoUrl(urls[8]))
        && (urls.size() < 10 || isValidPhotoUrl(urls[9]));
    }

    function isValidEventType(value) {
      return value in ['wedding', 'birthday', 'graduation', 'religious-milestone', 'other'];
    }

    match /events/{slug} {
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidSlug(slug)
        && request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.keys().hasOnly([
          'coupleNames',
          'eventDate',
          'eventType',
          'ownerUid',
          'welcomeMessage',
          'themeColor',
          'createdAt',
          'signTheme'
        ])
        && request.resource.data.coupleNames is string
        && request.resource.data.coupleNames.size() > 0
        && request.resource.data.coupleNames.size() <= 120
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.signTheme in [
          'classic',
          'botanical',
          'modern',
          'art-deco',
          'coastal',
          'midnight'
        ]
        && (!('eventDate' in request.resource.data) || request.resource.data.eventDate is timestamp)
        && (!('eventType' in request.resource.data)
          || isValidEventType(request.resource.data.eventType))
        && (!('welcomeMessage' in request.resource.data)
          || (request.resource.data.welcomeMessage is string
            && request.resource.data.welcomeMessage.size() <= 500))
        && (!('themeColor' in request.resource.data)
          || request.resource.data.themeColor.matches('^#[0-9A-Fa-f]{6}$'));
      allow update, delete: if false;

      match /secrets/{id} {
        allow read: if false;
        allow create: if id == 'host'
          && request.resource.data.keys().hasOnly(['hostTokenHash'])
          && isHexSha256(request.resource.data.hostTokenHash);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if resource.data.isHidden == false;
        allow create: if request.resource.data.keys().hasOnly([
            'guestName',
            'text',
            'photoUrls',
            'videoUrl',
            'videoStatus',
            'createdAt',
            'isHidden'
          ])
          && request.resource.data.createdAt == request.time
          && request.resource.data.isHidden == false
          && ('text' in request.resource.data
            || ('photoUrls' in request.resource.data && request.resource.data.photoUrls.size() > 0)
            || ('videoStatus' in request.resource.data
              && request.resource.data.videoStatus == 'processing'))
          && (!('guestName' in request.resource.data)
            || (request.resource.data.guestName is string
              && request.resource.data.guestName.size() > 0
              && request.resource.data.guestName.size() <= 80))
          && (!('text' in request.resource.data)
            || (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000))
          && (!('photoUrls' in request.resource.data)
            || isValidPhotoUrls(request.resource.data.photoUrls))
          && (
            (!('videoStatus' in request.resource.data)
              && !('videoUrl' in request.resource.data))
            || (
              request.resource.data.videoStatus == 'processing'
              && !('videoUrl' in request.resource.data)
              && !('photoUrls' in request.resource.data)
            )
          );
        // Possession of the plaintext host token is the credential.
        // The client hashes it and rules compare against a write-only secret.
        allow update: if resource.data.isHidden == false
          && request.resource.data.isHidden == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isHidden', 'hostTokenHash'])
          && isHexSha256(request.resource.data.hostTokenHash)
          && request.resource.data.hostTokenHash
            == get(/databases/$(database)/documents/events/$(slug)/secrets/host).data.hostTokenHash;
        allow delete: if false;
      }
    }
  }
}
