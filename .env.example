# Copy to `.env.local` for local development. Never commit real secrets.

# Auth.js session encryption (required)
AUTH_SECRET=generate-a-long-random-string

# Canonical app URL (Auth.js callbacks). Use http://localhost:3000 locally.
AUTH_URL=http://localhost:3000

# Required when running behind Vercel's reverse proxy
AUTH_TRUST_HOST=true

# Firebase Admin SDK — verify ID tokens on the server (Vercel env vars in production)
# From Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Use Firebase emulators (matches pnpm dev:emu)
# NEXT_PUBLIC_TOASTBOARD_EMULATORS=1
