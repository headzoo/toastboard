# Copy to `.env.local` for local development. Never commit real secrets.

# Auth.js session encryption (required)
AUTH_SECRET=generate-a-long-random-string

# Required when running behind Firebase App Hosting / a reverse proxy
AUTH_TRUST_HOST=true

# Firebase Admin SDK (local dev — App Hosting uses Secret Manager in production)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Use Firebase emulators (matches pnpm dev:emu)
# NEXT_PUBLIC_TOASTBOARD_EMULATORS=1
